---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AI_TYPE_LABELS } from '../lib/labels';
import { CATEGORIES } from '../lib/content-contract.mjs';
import { sortProjects } from '../lib/sorting';
import { DATA_SOURCES, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../lib/site';

const projects = await getCollection('projects');

// 构建期排序：上线时间降序 → 阅读量降序（客户端会沿用同一规则并叠加本地计数增量）
const sorted = sortProjects(
  projects.map((project) => ({
    slug: project.data.slug,
    launchDate: project.data.launchDate,
    views: project.data.metrics.views,
    project,
  })),
).map((item) => item.project);

const total = sorted.length;
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1 class="hero-title">{SITE_TAGLINE}</h1>
    <p class="hero-lead">
      本站收录全球范围内<strong>由单人创立、且以 AI 作为核心生产力</strong>的公司案例，
      逐篇记录其成立背景、历时性节奏、同期横向对标、七维深度拆解与争议点，
      并为每条结论标注信源与置信度。
    </p>
    <dl class="hero-stats">
      <div class="hero-stat">
        <dt>收录案例</dt>
        <dd>{total}</dd>
      </div>
      <div class="hero-stat">
        <dt>类别覆盖</dt>
        <dd>{CATEGORIES.length}</dd>
      </div>
      <div class="hero-stat">
        <dt>信源类型</dt>
        <dd>5 类</dd>
      </div>
    </dl>
    <p class="hero-note">收录口径：{DATA_SOURCES}</p>
  </section>

  <section class="filters" aria-label="案例筛选">
    <div class="filter-row">
      <label class="filter-search">
        <span class="filter-label">关键词</span>
        <input
          type="search"
          data-search-input
          placeholder="搜索标题、简介、创始人或类别"
          autocomplete="off"
        />
      </label>
      <p class="filter-count" data-result-count aria-live="polite">共 {total} 个案例</p>
    </div>

    <div class="filter-row">
      <span class="filter-label" id="category-filter-label">类别</span>
      <div class="filter-buttons" role="group" aria-labelledby="category-filter-label">
        {
          CATEGORIES.map((category) => (
            <button type="button" class="filter-button" data-category-filter={category} aria-pressed="false">
              {category}
            </button>
          ))
        }
      </div>
    </div>

    <div class="filter-row">
      <span class="filter-label" id="ai-type-filter-label">AI 契合类型</span>
      <div class="filter-buttons" role="group" aria-labelledby="ai-type-filter-label">
        {
          Object.entries(AI_TYPE_LABELS).map(([value, label]) => (
            <button type="button" class="filter-button" data-ai-type-filter={value} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  {
    total === 0 ? (
      <section class="article">
        <h2>案例内容尚未导入</h2>
        <p class="meta">
          内容集合 <code>src/content/projects/</code> 当前为空，后续将批量写入案例。
        </p>
      </section>
    ) : (
      <section class="grid" data-project-grid>
        {sorted.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            slug={project.data.slug}
            categories={project.data.category}
            hq={project.data.hq}
            founded={project.data.founded}
            founder={project.data.founder}
            launchDate={project.data.launchDate}
            launchDatePrecision={project.data.launchDatePrecision}
            aiType={project.data.aiType}
            views={project.data.metrics.views}
            likes={project.data.metrics.likes}
            shares={project.data.metrics.shares}
          />
        ))}
      </section>
    )
  }

  <p class="empty-state" data-empty-state hidden>
    没有匹配的案例，换个关键词或调整筛选条件试试。
  </p>
</BaseLayout>

<script>
  import '../scripts/home';
</script>
