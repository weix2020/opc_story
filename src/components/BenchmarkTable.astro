---
import { cellCitations } from '../lib/body-sections';

/** 横向对标表格的一行 */
interface BenchmarkRow {
  /** 对标项目名称 */
  project: string;
  /** 成立时间 */
  founded: string;
  /** 团队规模 */
  teamSize: string;
  /** 变现模式 */
  businessModel: string;
  /** 营收规模 */
  revenue: string;
  /** 融资状态 */
  funding: string;
  /** 信源标记（如 [S1]） */
  source: string;
}

interface Props {
  /** 对标数据行 */
  rows: BenchmarkRow[];
}

const { rows } = Astro.props;
---

<div class="table-scroll">
  <table class="benchmark-table">
    <thead>
      <tr>
        <th>对标项目</th>
        <th>成立时间</th>
        <th>团队规模</th>
        <th>变现模式</th>
        <th>营收规模</th>
        <th>融资状态</th>
        <th>信源</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="benchmark-project">{row.project}</td>
            <td>{row.founded}</td>
            <td>{row.teamSize}</td>
            <td>{row.businessModel}</td>
            <td>{row.revenue}</td>
            <td>{row.funding}</td>
            <td set:html={cellCitations(row.source)} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
