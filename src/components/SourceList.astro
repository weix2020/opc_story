---
import { formatIsoDate, sourceTypeLabel } from '../lib/labels';

/** 单条信源的前端数据类型，与 content.config.ts 的 schema 对应 */
interface Source {
  id: number;
  title: string;
  publisher: string;
  publishedAt: string;
  accessedAt: string;
  type: string;
  url: string;
}

interface Props {
  /** 信源列表 */
  sources: Source[];
}

const { sources } = Astro.props;
---

<div class="table-scroll">
  <table class="source-table">
    <thead>
      <tr>
        <th>编号</th>
        <th>标题</th>
        <th>发布方</th>
        <th>发布日期</th>
        <th>访问日期</th>
        <th>类型</th>
        <th>链接</th>
      </tr>
    </thead>
    <tbody>
      {
        sources.map((source) => (
          <tr id={`source-${source.id}`}>
            <td class="source-id">[S{source.id}]</td>
            <td>{source.title}</td>
            <td>{source.publisher}</td>
            <td>{formatIsoDate(source.publishedAt)}</td>
            <td>{formatIsoDate(source.accessedAt)}</td>
            <td>
              <span class={`badge badge-source badge-source-${source.type}`}>
                {sourceTypeLabel(source.type)}
              </span>
            </td>
            <td>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                查看原文
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
