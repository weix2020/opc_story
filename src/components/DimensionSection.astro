---
/**
 * 七维深度分析的单个小节容器：标题 + 正文插槽。
 */
interface Props {
  /** 小节标题（如「1. 产品功能」） */
  title: string;
  /** 小节序号（1-7），用于展示序号圆点 */
  index?: number;
}

const { title, index } = Astro.props;
---

<section class="dimension">
  <h3 class="dimension-title">
    {index !== undefined && <span class="dimension-index" aria-hidden="true">{index}</span>}
    <span>{title}</span>
  </h3>
  <div class="dimension-body">
    <slot />
  </div>
</section>
